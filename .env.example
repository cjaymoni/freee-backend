# Server Configuration
NODE_ENV=development
PORT=3000

# Logging
LOG_LEVEL=info # error, warn, info, debug, verbose

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_DATABASE=freee

# Database Connection Pooling
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Production Database URL (Neon, AWS RDS, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Upstash Redis (Cloud Alternative)
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# JWT Configuration
JWT_SECRET=your_very_secure_jwt_secret_key_here_min_32_chars

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
PASSWORD_MIN_LENGTH=8

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Configuration (Email Service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Firebase Configuration
# Option 1: JSON string (recommended for production)
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project",...}'

# Option 2: File path (recommended for local development)
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json

# AWS Secrets Manager (Production)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# USE_AWS_SECRETS=true

# Monitoring & Alerting (Optional)
# SENTRY_DSN=https://your-sentry-dsn
# NEW_RELIC_LICENSE_KEY=your_new_relic_key
# DATADOG_API_KEY=your_datadog_key
