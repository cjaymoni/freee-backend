# Staging (Render) — the values the service needs in its Render dashboard.
# render.yaml already sets everything that is not a secret; this file is the
# readable copy of the whole set. Walkthrough: docs/STAGING_DEPLOYMENT.md
#
# Never copy a production value into here.

# TypeORM only runs migrations and forces synchronize off when NODE_ENV is
# production, so staging claims production and APP_ENV names it properly.
NODE_ENV=production
APP_ENV=staging
PORT=3000
LOG_LEVEL=debug

# Neon Postgres — the DIRECT (non-pooled) connection string. The pooled
# "-pooler" host runs PgBouncer in transaction mode, which the migrations that
# run on boot do not sit well with.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/freee_staging?sslmode=require
# Neon's free tier is stingy with connections and staging is a single instance.
DB_POOL_MAX=5

# Upstash Redis — a staging database of its own, never production's.
UPSTASH_REDIS_REST_URL=https://your-staging-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_staging_token

# Render generates this (render.yaml: generateValue), so staging tokens are
# worthless against production and vice versa.
JWT_SECRET=generated_by_render

# Cloudinary — a staging folder or, better, a separate cloud.
CLOUDINARY_CLOUD_NAME=your_staging_cloud
CLOUDINARY_API_KEY=your_staging_key
CLOUDINARY_API_SECRET=your_staging_secret

# SMTP. Point staging at a catcher (Mailtrap, Brevo sandbox) so a test run
# cannot email real users.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_staging_user
SMTP_PASS=your_staging_password

# Firebase service account for the STAGING Firebase project, as one line.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"freee-staging",...}'

# Sign-in providers. Add the three TWILIO_* values before switching
# SMS_PROVIDER to twilio — env validation requires them then.
SMS_PROVIDER=firebase
SMS_FALLBACK_ENABLED=true
SMS_ALLOWED_PREFIXES=+233
EMAIL_PROVIDER=firebase
EMAIL_FALLBACK_ENABLED=true

FOUNDING_FREERS_OPEN=true
