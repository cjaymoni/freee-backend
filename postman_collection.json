              "raw": "{\n  \"title\": \"Old Sofa\",\n  \"description\": \"A comfortable 3-seater sofa\",\n  \"category_id\": \"{{categoryId}}\",\n  \"location_id\": \"{{locationId}}\",\n  \"condition\": \"good\",\n  \"is_free\": true\n}"
